import { Head } from '@inertiajs/react'

import './home.css'

<% if use_typescript %>
interface HomeProps {
  rails_version: string
  ruby_version: string
  inertia_rails_version: string
}

export default function Home({ rails_version, ruby_version, inertia_rails_version }: HomeProps) {
<% else %>
export default function Home({ rails_version, ruby_version, inertia_rails_version }) {
<% end %>
  return (
    <main className="inertia-home">
      <Head title="Inertia on Rails" />
      <a href="https://inertia-rails.dev" aria-label="Inertia Rails documentation" />
      <footer>
        <p>
          <strong>Rails version:</strong> {rails_version}
        </p>
        <p>
          <strong>Ruby version:</strong> {ruby_version}
        </p>
        <p>
          <strong>Inertia Rails version:</strong> {inertia_rails_version}
        </p>
      </footer>
    </main>
  )
}

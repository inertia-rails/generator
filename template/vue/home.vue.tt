<template>
  <Head title="Inertia on Rails" />
  <main class="inertia-home">
    <a href="https://inertia-rails.dev" aria-label="Inertia Rails documentation"></a>
    <footer>
      <p><strong>Rails version:</strong> {{ rails_version }}</p>
      <p><strong>Ruby version:</strong> {{ ruby_version }}</p>
      <p><strong>Inertia Rails version:</strong> {{ inertia_rails_version }}</p>
    </footer>
  </main>
</template>

<% if use_typescript %>
<script setup lang="ts">
import { Head } from '@inertiajs/vue3'

import './home.css'

defineProps<{
  rails_version: string
  ruby_version: string
  inertia_rails_version: string
}>()
</script>
<% else %>
<script setup>
import { Head } from '@inertiajs/vue3'

import './home.css'

defineProps({
  rails_version: String,
  ruby_version: String,
  inertia_rails_version: String,
})
</script>
<% end %>
